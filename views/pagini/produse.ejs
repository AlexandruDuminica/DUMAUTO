<!DOCTYPE html>
<html lang="ro">
<head>
    <title>Produse - DUM AUTO</title>
    <%- include('../fragmente/head') %>
    <link rel="stylesheet" href="/resurse/css/produse.css">
    <style>/* minimal layout adjustments if produse.css missing */
    </style>
</head>
<body id="top">
    <%- include('../fragmente/header') %>

    <main class="container-produse">
        <h2>Produse</h2>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>Produse afișate: <span id="numar-produse"><%= produse.length %></span></div>
            <% if (typeof currentOffer !== 'undefined' && currentOffer) { %>
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-0" role="alert" id="oferta-banner">
                    <i class="bi bi-megaphone-fill text-danger"></i>
                    <span>Ofertă: <strong><%= currentOffer.categorie %></strong> &mdash;
                    <span class="badge bg-danger"><%= currentOffer.reducere %>%</span> reducere.
                    Se încheie în <strong><span id="timer-oferta">...</span></strong></span>
                </div>
            <% } %>
        </div>

        <section id="filtre-produs" class="mb-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-3">
                    <label class="form-label">Nume</label>
                    <input type="text" id="filtru-nume" class="form-control form-control-sm" placeholder="Cauta dupa nume">
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Preț (EUR)</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small" id="min-pret-label"><%= pretMin %></span>
                        <input type="range" id="filtru-pret" class="form-range flex-grow-1" min="<%= pretMin %>" max="<%= pretMax %>" value="<%= pretMax %>">
                        <span class="text-muted small"><%= pretMax %> (<span id="val-pret"><%= pretMax %></span>)</span>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Subcategorie</label>
                    <input list="datalist-sub" id="filtru-sub" class="form-control form-control-sm">
                    <datalist id="datalist-sub">
                        <% let subs = new Set(); produse.forEach(p=>subs.add(p.subcategorie)); subs.forEach(s=>{ %>
                            <option value="<%= s %>"></option>
                        <% }) %>
                    </datalist>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Culoare</label>
                    <div class="btn-group" role="group" aria-label="Culoare">
                        <input type="radio" class="btn-check" name="culoare" id="culoare-toate" value="toate" autocomplete="off" checked>
                        <label class="btn btn-outline-primary btn-sm" for="culoare-toate">Toate</label>
                        <% let culori = new Set(); produse.forEach(p=>culori.add(p.culoare)); culori.forEach((c,i)=>{ %>
                            <input type="radio" class="btn-check" name="culoare" id="culoare-<%= i %>" value="<%= c %>" autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="culoare-<%= i %>"><%= c %></label>
                        <% }) %>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label d-block">Discount</label>
                    <input class="btn-check" type="checkbox" id="filtru-discount" autocomplete="off">
                    <label class="btn btn-outline-danger btn-sm" for="filtru-discount">Only &gt;30000</label>
                </div>

                <div class="col-12 col-md-4">
                    <div class="form-floating">
                        <textarea id="filtru-desc" class="form-control" placeholder="Filtru descriere" style="height:80px"></textarea>
                        <label for="filtru-desc">Filtru descriere</label>
                        <div class="invalid-feedback">Introduceți cel puțin 3 caractere pentru a filtra.</div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label">Luni (select multiplu)</label>
                    <select id="filtru-luni" class="form-select form-select-sm" multiple size="4">
                        <% const luni = ['Ianuarie','Februarie','Martie','Aprilie','Mai','Iunie','Iulie','August','Septembrie','Octombrie','Noiembrie','Decembrie'];
                           luni.forEach((ln,i)=>{ %>
                            <option value="<%= i+1 %>" selected><%= ln %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="col-12 col-md-8 d-flex gap-2 align-items-center flex-wrap">
                    <button id="btn-filtreaza" class="btn btn-primary btn-sm">
                        <i class="bi bi-funnel"></i> <span class="d-none d-md-inline">Filtreaza</span>
                    </button>
                    <!-- Bonus 8: sort keys -->
                    <select id="sort-key1" class="form-select form-select-sm" style="width:auto;" title="Cheie sortare 1">
                        <option value="pret">Preț</option>
                        <option value="nume">Nume</option>
                        <option value="putere_cp">Putere (CP)</option>
                        <option value="data">Data adăugării</option>
                    </select>
                    <select id="sort-key2" class="form-select form-select-sm" style="width:auto;" title="Cheie sortare 2">
                        <option value="none">— nicio a 2-a cheie —</option>
                        <option value="pret">Preț</option>
                        <option value="nume">Nume</option>
                        <option value="putere_cp">Putere (CP)</option>
                        <option value="data">Data adăugării</option>
                    </select>
                    <select id="sort-dir" class="form-select form-select-sm" style="width:auto;" title="Direcție sortare">
                        <option value="asc">↑ Crescător</option>
                        <option value="desc">↓ Descrescător</option>
                    </select>
                    <button id="btn-sort-asc" class="btn btn-primary btn-sm" title="Sortează">
                        <i class="bi bi-sort-alpha-down"></i> <span class="d-none d-md-inline">Sortează</span>
                    </button>
                    <button id="btn-calc" class="btn btn-secondary btn-sm">
                        <i class="bi bi-calculator"></i> <span class="d-none d-md-inline">Calculeaza</span>
                    </button>
                    <button id="btn-reset" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-counterclockwise"></i> <span class="d-none d-md-inline">Reset</span>
                    </button>
                    <button id="btn-server-filter" class="btn btn-outline-info btn-sm" title="Filtrare și sortare pe server (Bonus 10b)">
                        <i class="bi bi-cloud-download"></i> <span class="d-none d-md-inline">Server</span>
                    </button>

                    <div class="form-check ms-2">
                        <input class="form-check-input" type="checkbox" id="salveaza-filtrare">
                        <label class="form-check-label" for="salveaza-filtrare">Salvează filtrare</label>
                    </div>
                </div>
            </div>
        </section>

        <section id="lista-produse" class="grid-prod">
            <div id="no-products-msg" class="alert alert-info" style="display:none;grid-column:1/-1;">
                Nu există produse conform filtrării curente.
            </div>
            <% produse.forEach(p => { %>
                <article id="produs_<%= p.id %>" class="prod <%= p.categorie_mare.replace(/\s+/g,'') %><%= p.isCheapest ? ' prod-cheapest' : '' %>" data-id="<%= p.id %>">
                    <h3><a href="/produs/<%= p.id %>"><%= p.nume %></a></h3>
                    <div class="col-1">
                        <img src="<%= p.imagine %>" alt="<%= p.nume %>"/>
                        <div class="meta">
                            <span class="categ"><%= p.categorie_mare %></span> - 
                            <span class="pret">
                                <% if (p.pret_redus) { %>
                                    <span class="text-decoration-line-through text-muted"><%= p.pret %> EUR</span>
                                    <span class="ms-2 text-danger"><strong><%= p.pret_redus %> EUR</strong></span>
                                <% } else { %>
                                    <span><%= p.pret %> EUR</span>
                                <% } %>
                            </span>
                        </div>
                        <% if (p.isCheapest) { %>
                            <div class="cheapest-label"><i class="bi bi-star-fill"></i> Cel mai ieftin din categorie</div>
                        <% } %>
                        <% if (p.isNew) { %>
                            <span class="badge bg-info text-dark">NOU</span>
                        <% } %>
                        <div class="mt-2 d-flex gap-1 flex-wrap">
                            <button class="btn btn-outline-primary btn-sm btn-compare" data-id="<%= p.id %>" data-name="<%= p.nume %>" title="Compară produsul"><i class="bi bi-link-45deg"></i></button>
                            <button class="btn btn-outline-warning btn-sm btn-pin" data-id="<%= p.id %>" title="Fixează produsul (nu dispare la filtrare)"><i class="bi bi-pin-angle-fill"></i></button>
                            <button class="btn btn-outline-secondary btn-sm btn-remove-temp" data-id="<%= p.id %>" title="Ascunde temporar produsul (revine la resetare/filtrare)"><i class="bi bi-eye-slash"></i></button>
                            <button class="btn btn-outline-danger btn-sm btn-remove-session" data-id="<%= p.id %>" title="Ascunde produsul pe toată sesiunea acestui tab"><i class="bi bi-trash3"></i></button>
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="accordion accordion-flush" id="acc-<%= p.id %>">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed py-1 px-2" type="button" data-bs-toggle="collapse" data-bs-target="#acc-<%= p.id %>-spec" aria-expanded="false" aria-controls="acc-<%= p.id %>-spec">Specificații</button>
                                </h2>
                                <div id="acc-<%= p.id %>-spec" class="accordion-collapse collapse">
                                    <div class="accordion-body p-2">
                                        <ul class="list-unstyled mb-0" style="font-size:0.85rem;">
                                            <li><strong>Subcategorie:</strong> <i><%= p.subcategorie %></i></li>
                                            <li><strong>Caracteristici:</strong> <i><%= p.caracteristici_multiple %></i></li>
                                            <li><strong>Putere (CP):</strong> <i><%= p.putere_cp %></i></li>
                                            <li><strong>Data adăugare:</strong> <i><time><%= p.formattedDate %></time></i></li>
                                            <li><strong>In stoc:</strong> <i><%= p.in_stoc ? 'Da' : 'Nu' %></i></li>
                                            <li><strong>Culoare:</strong> <i><%= p.culoare %></i></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed py-1 px-2" type="button" data-bs-toggle="collapse" data-bs-target="#acc-<%= p.id %>-desc" aria-expanded="false" aria-controls="acc-<%= p.id %>-desc">Descriere</button>
                                </h2>
                                <div id="acc-<%= p.id %>-desc" class="accordion-collapse collapse">
                                    <div class="accordion-body p-2">
                                        <p class="descriere mb-0" style="font-size:0.85rem;"><%= p.descriere %></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            <% }) %>
        </section>
    </main>
    <!-- Modal container -->
    <div id="prod-modal" class="prod-modal" style="display:none;position:fixed;inset:0;align-items:center;justify-content:center;z-index:2000;">
        <div class="prod-modal-backdrop" style="position:absolute;inset:0;background:rgba(0,0,0,0.5);"></div>
        <div class="prod-modal-card" style="background:var(--zone-bg);color:var(--text-color);padding:1rem;border-radius:0.6rem;max-width:800px;z-index:2100;">
            <button id="prod-modal-close" class="btn-close float-end" aria-label="Close"></button>
            <div id="prod-modal-content"></div>
        </div>
    </div>

    <script src="/resurse/js/produse.js"></script>
    <script src="/resurse/js/compare.js"></script>
    <%- include('../fragmente/footer') %>
</body>
</html>
